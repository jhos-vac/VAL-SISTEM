generator client {
  provider = "prisma-client"
  output   = "../generated/automation-cli"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model AutomationRules {
  id                   String                 @id @default(uuid()) @db.Uuid
  userId               String                 @map("user_id") @db.Uuid
  name                 String
  description          String
  isActive             Boolean                @default(true) @map("is_active")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @default(now()) @map("updated_at")
  automationConditions AutomationConditions[]
  automationActions    AutomationActions[]
  automationSchedules  AutomationSchedules[]
  automationExecutions AutomationExecution[]

  @@map("automation_rules")
}

model AutomationConditions {
  id            String   @id @default(uuid()) @db.Uuid
  ruleId        String   @map("rule_id") @db.Uuid
  conditionType String   @map("condition_type")
  source        String
  assetId       String   @map("asset_id") @db.Uuid
  portfolioId   String   @map("portfolio_id") @db.Uuid
  operator      String
  value         String
  configuration Json
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @map("updated_at")

  rule AutomationRules @relation(fields: [ruleId], references: [id])

  @@map("automation_conditions")
}

model AutomationActions {
  id            String   @id @default(uuid()) @db.Uuid
  ruleId        String   @map("rule_id") @db.Uuid
  actionType    String   @map("action_type")
  configuration Json
  executeOrder  Int      @map("execute_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @map("updated_at")

  rule AutomationRules @relation(fields: [ruleId], references: [id])

  @@map("automation_actions")
}

model AutomationSchedules {
  id             String    @id @default(uuid()) @db.Uuid
  ruleId         String    @map("rule_id") @db.Uuid
  cronExpression String    @map("cron_expression")
  timezone       String
  nextExecution  DateTime  @map("next_execution")
  lastExecution  DateTime? @map("last_execution")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @map("updated_at")

  rule AutomationRules @relation(fields: [ruleId], references: [id])

  @@map("automation_schedules")
}

model AutomationExecution {
  id         String   @id @default(uuid()) @db.Uuid
  ruleId     String   @map("rule_id") @db.Uuid
  status     String
  startedAt  DateTime @map("started_at")
  finishedAt DateTime @map("finished_at")
  duration   Int      @map("duration")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @map("updated_at")

  rule          AutomationRules @relation(fields: [ruleId], references: [id])
  executionLogs ExecutionLog[]

  @@map("automation_executions")
}

model ExecutionLog {
  id          String   @id @default(uuid()) @db.Uuid
  executionId String   @map("execution_id") @db.Uuid
  level       String
  logType     String   @map("log_type")
  message     String
  createdAt   DateTime @default(now()) @map("created_at")

  execution AutomationExecution @relation(fields: [executionId], references: [id])

  @@map("execution_logs")
}

model Alert {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @map("user_id") @db.Uuid
  portfolioId        String              @map("portfolio_id") @db.Uuid
  name               String
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @default(now()) @map("updated_at")
  alertConditions    AlertCondition[]
  alertNotifications AlertNotification[]

  @@map("alerts")
}

model AlertCondition {
  id            String   @id @default(uuid()) @db.Uuid
  alertId       String   @map("alert_id") @db.Uuid
  operator      String
  targetValue   String   @map("target_value")
  conditionType String   @map("condition_type")
  configuration Json
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @map("updated_at")

  alert Alert @relation(fields: [alertId], references: [id])

  @@map("alert_conditions")
}

model AlertNotification {
  id                    String   @id @default(uuid()) @db.Uuid
  alertId               String   @map("alert_id") @db.Uuid
  notificationChannelId String   @map("notification_channel_id") @db.Uuid
  triggeredAt           DateTime @map("triggered_at")
  delivered             Boolean
  message               String
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @default(now()) @map("updated_at")

  alert               Alert               @relation(fields: [alertId], references: [id])
  notificationChannel NotificationChannel @relation(fields: [notificationChannelId], references: [id])

  @@map("alert_notifications")
}

model NotificationChannel {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  channelType String   @map("channel_type")
  destination String
  isVerified  Boolean  @map("is_verified")
  isEnabled   Boolean  @default(false) @map("is_enabled")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")

  alertNotifications    AlertNotification[]
  notificationHistories NotificationHistory[]

  @@map("notification_channels")
}

model NotificationHistory {
  id                    String   @id @default(uuid()) @db.Uuid
  notificationChannelId String   @map("notification_channel_id") @db.Uuid
  notificationType      String   @map("notification_type")
  title                 String
  message               String
  status                String
  sentAt                DateTime @map("sent_at")
  createdAt             DateTime @default(now()) @map("created_at")

  notificationChannel NotificationChannel @relation(fields: [notificationChannelId], references: [id])

  @@map("notification_histories")
}

model Webhook {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  url       String
  secret    String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("webhooks")
}
