generator client {
  provider = "prisma-client"
  output   = "../generated/portfolio-cli"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Portfolio {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  name         String
  description  String
  baseCurrency String   @map("base_currency")
  isDefault    Boolean  @default(false) @map("is_default")
  // Publicación opt-in en el ranking: solo se muestran % de rendimiento y
  // composición, nunca montos. El alias lo elige el dueño al publicar.
  isPublic     Boolean   @default(false) @map("is_public")
  publicAlias  String?   @map("public_alias")
  publishedAt  DateTime? @map("published_at")
  // Portafolio público del que se copió la composición (si aplica).
  copiedFromId String?   @map("copied_from_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @map("updated_at")
  wallets      Wallet[]

  investmentGoals        InvestmentGoal[]
  portfolioSnapshots     PortfolioSnapshot[]
  portfolioAssetSummaries PortfolioAssetSummary[]
  targetAllocations      TargetAllocation[]
  dcaPlans               DcaPlan[]

  @@index([isPublic])
  @@map("portfolios")
}

model ExchangeAccount {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  exchangeId  String   @map("exchange_id") @db.Uuid
  accountName String   @map("account_name")
  apiKey      String   @map("api_key")
  apiSecret   String   @map("api_secret")
  isTestnet   Boolean  @default(false) @map("is_testnet")
  syncEnabled Boolean  @default(true) @map("sync_enabled")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")
  wallets     Wallet[]

  @@map("exchange_accounts")
}

model Wallet {
  id                String   @id @default(uuid()) @db.Uuid
  portfolioId       String   @map("portfolio_id") @db.Uuid
  exchangeAccountId String?  @map("exchange_account_id") @db.Uuid
  walletName        String   @map("wallet_name")
  walletType        String   @map("wallet_type")
  address           String   @unique
  network           String
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @map("updated_at")

  portfolio       Portfolio        @relation(fields: [portfolioId], references: [id])
  exchangeAccount ExchangeAccount? @relation(fields: [exchangeAccountId], references: [id])
  assetPositions  AssetPosition[]

  transfersFrom Transfer[] @relation("TransferFrom")
  transfersTo   Transfer[] @relation("TransferTo")

  @@map("wallets")
}

model AssetPosition {
  id               String   @id @default(uuid()) @db.Uuid
  walletId         String   @map("wallet_id") @db.Uuid
  assetId          String   @map("asset_id") @db.Uuid
  quantity         Float
  avgPrice         Float    @map("avg_price")
  realizedProfit   Float    @map("realized_profit")
  unrealizedProfit Float    @map("unrealized_profit")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @map("updated_at")

  wallet       Wallet        @relation(fields: [walletId], references: [id])
  transactions Transaction[]

  @@unique([walletId, assetId])
  @@map("asset_positions")
}

model TransactionType {
  id          String @id @default(uuid()) @db.Uuid
  code        String @unique
  name        String @unique
  description String

  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @default(now()) @map("updated_at")
  transactions Transaction[]

  @@map("transaction_types")
}

model Transaction {
  id                String   @id @default(uuid()) @db.Uuid
  assetPositionId   String   @map("asset_position_id") @db.Uuid
  transactionTypeId String   @map("transaction_type_id") @db.Uuid
  exchangeOrderId   String?  @map("exchange_order_id") @db.Uuid
  quantity          Float
  price             Float
  fee               Float
  total             Float
  notes             String?
  executedAt        DateTime @map("executed_at")
  createdAt         DateTime @default(now()) @map("created_at")

  assetPosition   AssetPosition   @relation(fields: [assetPositionId], references: [id])
  transactionType TransactionType @relation(fields: [transactionTypeId], references: [id])

  @@map("transactions")
}

model Transfer {
  id           String   @id @default(uuid()) @db.Uuid
  fromWalletId String   @map("from_wallet_id") @db.Uuid
  toWalletId   String   @map("to_wallet_id") @db.Uuid
  assetId      String   @map("asset_id") @db.Uuid
  quantity     Float
  fee          Float
  transferAt   DateTime @map("executed_at")
  createdAt    DateTime @default(now()) @map("created_at")

  fromWallet Wallet @relation("TransferFrom", fields: [fromWalletId], references: [id])
  toWallet   Wallet @relation("TransferTo", fields: [toWalletId], references: [id])

  @@map("transfers")
}

model Watchlist {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  name      String
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @default(now()) @map("updated_at")
  assets    WatchListAsset[]

  @@map("watchlists")
}

model WatchListAsset {
  id          String   @id @default(uuid()) @db.Uuid
  watchlistId String   @map("watchlist_id") @db.Uuid
  assetId     String   @map("asset_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")

  watchlist Watchlist @relation(fields: [watchlistId], references: [id])

  @@unique([watchlistId, assetId])
  @@map("watchlist_assets")
}

// Meta de un portafolio (o de un activo dentro de él):
//  - kind 'target_value': llegar a targetValue (en la moneda base),
//    opcionalmente antes de deadline.
//  - kind 'gain_percent': llegar a targetPercent de ganancia sobre lo
//    invertido (p.ej. 10 = +10 %).
// Las columnas targetPrice/targetQuantity vienen del diseño original y
// quedan opcionales.
model InvestmentGoal {
  id             String    @id @default(uuid()) @db.Uuid
  portfolioId    String    @map("portfolio_id") @db.Uuid
  assetId        String?   @map("asset_id") @db.Uuid
  name           String    @default("")
  kind           String    @default("target_value")
  targetValue    Float?    @map("target_value")
  targetPercent  Float?    @map("target_percent")
  targetPrice    Float?    @map("target_price")
  targetQuantity Float?    @map("target_quantity")
  deadline       DateTime? @map("deadline")
  isCompleted    Boolean   @default(false) @map("is_completed")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @map("updated_at")

  portfolio Portfolio @relation(fields: [portfolioId], references: [id])

  @@map("investment_goals")
}

// Estrategia: % objetivo de cada activo dentro del portafolio. La suma
// puede ser menor a 100 (el resto queda sin asignar).
model TargetAllocation {
  id            String @id @default(uuid()) @db.Uuid
  portfolioId   String @map("portfolio_id") @db.Uuid
  assetId       String @map("asset_id") @db.Uuid
  targetPercent Float  @map("target_percent")

  portfolio Portfolio @relation(fields: [portfolioId], references: [id])

  @@unique([portfolioId, assetId])
  @@map("target_allocations")
}

// Estrategia: plan de compras periódicas (DCA) de un activo.
// frequency: 'weekly' | 'biweekly' | 'monthly'.
model DcaPlan {
  id          String    @id @default(uuid()) @db.Uuid
  portfolioId String    @map("portfolio_id") @db.Uuid
  assetId     String    @map("asset_id") @db.Uuid
  amount      Float
  frequency   String
  startDate   DateTime  @map("start_date")
  endDate     DateTime? @map("end_date")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @map("updated_at")

  portfolio Portfolio @relation(fields: [portfolioId], references: [id])

  @@index([portfolioId])
  @@map("dca_plans")
}

model PortfolioSnapshot {
  id              String   @id @default(uuid()) @db.Uuid
  portfolioId     String   @map("portfolio_id") @db.Uuid
  totalValue      Float    @map("total_value")
  investmentValue Float    @map("investment_value")
  profit          Float    @map("profit")
  profitPercent   Float    @map("profit_percent")
  snapshotDate    DateTime @map("snapshot_date")

  createdAt DateTime @default(now()) @map("created_at")

  portfolio Portfolio                @relation(fields: [portfolioId], references: [id])
  items     PortfolioSnapshotItems[]

  @@unique([portfolioId, snapshotDate])
  @@map("portfolio_snapshots")
}

model PortfolioSnapshotItems {
  id         String @id @default(uuid()) @db.Uuid
  snapshotId String @map("snapshot_id") @db.Uuid
  assetId    String @map("asset_id") @db.Uuid
  quantity   Float
  value      Float
  allocation Float

  createdAt DateTime @default(now()) @map("created_at")

  portfolioSnapshot PortfolioSnapshot @relation(fields: [snapshotId], references: [id])

  @@unique([snapshotId, assetId])
  @@map("portfolio_snapshot_items")
}

model PortfolioAssetSummary {
  id               String @id @default(uuid()) @db.Uuid
  portfolioId      String @map("portfolio_id") @db.Uuid
  assetId          String @map("asset_id") @db.Uuid
  totalQuantity    Float  @map("total_quantity")
  averageCost      Float  @map("average_cost")
  currentValue     Float  @map("current_value")
  invested         Float
  unrealizedProfit Float  @map("unrealized_profit")
  realizedProfit   Float  @map("realized_profit")

  updatedAt DateTime @default(now()) @map("updated_at")

  portfolio Portfolio @relation(fields: [portfolioId], references: [id])

  @@unique([portfolioId, assetId])
  @@map("portfolio_asset_summaries")
}

model SyncHistory {
  id                String   @id @default(uuid()) @db.Uuid
  exchangeAccountId String   @map("exchange_account_id") @db.Uuid
  status            String
  startedAt         DateTime @map("started_at")
  finishedAt        DateTime @map("finished_at")
  recordsProcessed  Int      @map("records_processed")
  message           String?
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("sync_history")
}

// Monedas "capital" de un usuario (p.ej. USDT como dólares virtuales):
// cuentan en el valor total pero no en invertido, ganancias ni variación
// 24h. Por usuario, así aplica igual a todos sus portafolios y a la vista
// General.
model CapitalAsset {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  assetId   String   @map("asset_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, assetId])
  @@map("capital_assets")
}

// Lease de los jobs periódicos (sync de precios, de cuentas, snapshots):
// con más de una instancia del backend, solo la que toma el lease corre el
// job. Es coordinación, no datos de negocio; vive acá por ser la base que
// ya usan los jobs más pesados.
model JobLease {
  name        String   @id
  lockedUntil DateTime @map("locked_until")
  lockedBy    String   @map("locked_by")
  // Resultado de la última corrida (para el panel de administración).
  lastStartedAt  DateTime? @map("last_started_at")
  lastFinishedAt DateTime? @map("last_finished_at")
  lastOk         Boolean?  @map("last_ok")
  lastError      String?   @map("last_error")
  lastDurationMs Int?      @map("last_duration_ms")

  @@map("job_leases")
}
