# Cada servicio/dominio tiene su propia base de datos independiente
# (ver prisma/prisma-*-database/prisma.config.ts). No se deben unir con FKs.
#
# Valores por defecto para levantar Postgres local con Docker:
#   docker compose up -d
# Se usa el puerto 5433 (no 5432) para no chocar con un Postgres
# que ya tengas instalado y corriendo directo en Windows.
DATABASE_USER="postgresql://postgres:postgres@localhost:5433/val_user"
DATABASE_MARKET="postgresql://postgres:postgres@localhost:5433/val_market"
DATABASE_PORTFOLIO="postgresql://postgres:postgres@localhost:5433/val_portfolio"
DATABASE_AUTOMATION="postgresql://postgres:postgres@localhost:5433/val_automation"

# Puerto en el que escucha el backend NestJS
PORT=3000

# --- Identity & Auth ---
# Secreto para firmar los access tokens JWT. Generar uno propio real:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
# Vida corta a propósito: el access token no vuelve a consultar la base en
# cada request, así que si un usuario se desactiva, esto acota cuánto
# tiempo puede seguir usando un token ya emitido.
JWT_ACCESS_EXPIRES_IN="15m"
# Vida del refresh token (opaco, rotado, guardado hasheado en la base).
JWT_REFRESH_EXPIRES_IN_DAYS=30

# Orígenes permitidos por CORS (separados por coma si son varios). Debe
# incluir el origen exacto del frontend web para que la cookie httpOnly
# de refresh token funcione (credentials:true).
CORS_ORIGIN="http://localhost:3001"

# true en producción (HTTPS) — la cookie de refresh token solo se manda
# por HTTPS. En localhost sin HTTPS debe quedar en false.
COOKIE_SECURE="false"

# --- Exchange / Sync ---
# Clave AES-256 (hex, 32 bytes) para cifrar api_key/api_secret de
# ExchangeAccount en reposo. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32)).toString('hex'))"
EXCHANGE_CREDENTIALS_KEY="<generar-una-clave-hex-de-64-caracteres>"

# --- Email (recuperación de contraseña, agregado 28 sept 2026) ---
# API de Resend (https://resend.com) via HTTP directo (fetch), sin SDK
# nuevo instalado. Sin esta key, el link de reset se loguea por consola
# en vez de mandarse de verdad (sirve igual para probar el flujo).
RESEND_API_KEY=""
EMAIL_FROM="VAL-SISTEM <onboarding@resend.dev>"
# Usado para armar el link de /reset-password?token=... del email.
FRONTEND_URL="http://localhost:3001"
