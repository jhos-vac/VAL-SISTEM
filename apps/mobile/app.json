{
  "expo": {
    "name": "VAL-SISTEM",
    "slug": "val-sistem",
    "scheme": "valsistem",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.valsistem.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Usamos Face ID para desbloquear tu sesión sin escribir la contraseña."
      }
    },
    "android": {
      "package": "dev.valsistem.app",
      "adaptiveIcon": {
        "backgroundColor": "#051F20",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#EEF6EF",
          "dark": {
            "backgroundColor": "#051F20"
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Usamos Face ID para desbloquear tu sesión sin escribir la contraseña."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#235347"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "platforms": [
      "ios",
      "android"
    ]
  }
}
